STT_MODEL=turbo
STT_COMPUTE_TYPE=int8_float16
STT_IDLE_UNLOAD_SECONDS=300
STT_BEAM_SIZE=1
STT_BEST_OF=1
STT_TEMPERATURE=0
STT_NO_SPEECH_THRESHOLD=0.6
STT_LOG_PROB_THRESHOLD=-1.0
STT_COMPRESSION_RATIO_THRESHOLD=2.4
STT_REPETITION_PENALTY=1.0
STT_NO_REPEAT_NGRAM_SIZE=0
STT_CONDITION_ON_PREVIOUS_TEXT=false
STT_VAD_THRESHOLD=0.35
STT_VAD_MIN_SPEECH_MS=100
STT_VAD_MIN_SILENCE_MS=500
STT_VAD_SPEECH_PAD_MS=250
STT_HOTWORDS=VRChat、ぶいなび、VNavi、CordScribe、MCP、WordPress、Google Analytics、GA4、Search Console、SEO、RVC、BOOTH、Unity、Discord
# STT_TERMS_FILE=/home/natuki/cordscribe/runtime/transcription-terms.json
STT_INITIAL_PROMPT_ENABLED=false
# STT_INITIAL_PROMPT=VRChat、VRCosme、ぶいなび、Pulsoid、OSC、Poiyomi、lilToon
TRANSCRIPTION_DEBUG_LOG=false
TRANSCRIPTION_DEBUG_AUDIO=false
TRANSCRIPTION_DEBUG_AUDIO_DIR=/tmp/cordscribe-asr-debug
TRANSCRIPTION_DEBUG_AUDIO_MAX_FILES=100
